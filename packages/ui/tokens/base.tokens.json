{
  "space": {
    "$type": "dimension",
    "$description": "Échelle d'espacement en rem, sur une base de 4px.",
    "0": { "$value": { "value": 0, "unit": "rem" } },
    "1": { "$value": { "value": 0.25, "unit": "rem" } },
    "2": { "$value": { "value": 0.5, "unit": "rem" } },
    "3": { "$value": { "value": 0.75, "unit": "rem" } },
    "4": { "$value": { "value": 1, "unit": "rem" } },
    "5": { "$value": { "value": 1.25, "unit": "rem" } },
    "6": { "$value": { "value": 1.5, "unit": "rem" } },
    "8": { "$value": { "value": 2, "unit": "rem" } },
    "10": { "$value": { "value": 2.5, "unit": "rem" } },
    "12": { "$value": { "value": 3, "unit": "rem" } },
    "16": { "$value": { "value": 4, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "rem" } },
    "sm": { "$value": { "value": 0.125, "unit": "rem" } },
    "md": {
      "$value": { "value": 0.25, "unit": "rem" },
      "$description": "Champs et boutons"
    },
    "lg": {
      "$value": { "value": 0.5, "unit": "rem" },
      "$description": "Cartes et dialogues"
    },
    "full": { "$value": { "value": 999, "unit": "rem" } }
  },
  "border-width": {
    "$type": "dimension",
    "thin": { "$value": { "value": 1, "unit": "px" } },
    "thick": { "$value": { "value": 2, "unit": "px" } }
  },
  "focus": {
    "$type": "dimension",
    "width": { "$value": { "value": 2, "unit": "px" } },
    "offset": { "$value": { "value": 2, "unit": "px" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "serif": {
        "$value": ["Source Serif 4 Variable", "Source Serif 4", "Georgia", "serif"],
        "$description": "Titres"
      },
      "sans": {
        "$value": ["Source Sans 3 Variable", "Source Sans 3", "system-ui", "sans-serif"],
        "$description": "Texte et interface"
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": { "value": 0.75, "unit": "rem" } },
      "sm": { "$value": { "value": 0.875, "unit": "rem" } },
      "md": { "$value": { "value": 1, "unit": "rem" } },
      "lg": { "$value": { "value": 1.125, "unit": "rem" } },
      "xl": { "$value": { "value": 1.375, "unit": "rem" } },
      "2xl": { "$value": { "value": 1.75, "unit": "rem" } },
      "3xl": { "$value": { "value": 2.25, "unit": "rem" } }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.4 },
      "normal": { "$value": 1.5 }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": "#1F1C1814",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 2, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "lg": {
      "$value": {
        "color": "#1F1C1829",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 8, "unit": "px" },
        "blur": { "value": 24, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$description": "Dialogues et popovers"
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "base": { "$value": { "value": 200, "unit": "ms" } }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] }
  },
  "z": {
    "$type": "number",
    "dropdown": { "$value": 100 },
    "sticky": { "$value": 200 },
    "overlay": { "$value": 900 },
    "dialog": { "$value": 1000 },
    "toast": { "$value": 1100 }
  }
}
