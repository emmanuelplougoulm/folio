{
  "name": "@emmanuelplougoulm/folio",
  "version": "0.1.0",
  "description": "Design system Vue 3 sobre et éditorial, accessible par défaut.",
  "license": "MIT",
  "author": "Emmanuel Plougoulm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmanuelplougoulm/folio.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/emmanuelplougoulm/folio#readme",
  "bugs": "https://github.com/emmanuelplougoulm/folio/issues",
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "components",
    "accessibility",
    "a11y",
    "design-tokens",
    "reka-ui"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "folio-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "folio-source": "./src/styles/index.css",
      "default": "./dist/folio.css"
    },
    "./fonts.css": {
      "folio-source": "./src/styles/fonts.css",
      "default": "./dist/fonts.css"
    },
    "./base.css": {
      "folio-source": "./src/styles/base.css",
      "default": "./dist/base.css"
    },
    "./tokens/*.json": {
      "folio-source": "./src/styles/tokens-*.generated.json",
      "default": "./dist/tokens/*.json"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./style.css": {
        "default": "./dist/folio.css"
      },
      "./fonts.css": {
        "default": "./dist/fonts.css"
      },
      "./base.css": {
        "default": "./dist/base.css"
      },
      "./tokens/*.json": {
        "default": "./dist/tokens/*.json"
      }
    }
  },
  "scripts": {
    "build": "pnpm tokens && vite build && node scripts/copy-assets.mjs",
    "typecheck": "pnpm tokens && vue-tsc --noEmit -p tsconfig.json",
    "test": "pnpm tokens && vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project stories",
    "storybook": "pnpm tokens && storybook dev -p 6006",
    "build-storybook": "pnpm tokens && storybook build",
    "tokens": "node scripts/build-tokens.mjs",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --entrypoints ."
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.60.1",
    "@storybook/addon-a11y": "^10.6",
    "@storybook/addon-docs": "^10.6",
    "@storybook/addon-vitest": "^10.6",
    "@storybook/vue3-vite": "^10.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/user-event": "^14",
    "@testing-library/vue": "^8",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6",
    "@vitest/browser": "^5",
    "@vitest/browser-playwright": "^5",
    "happy-dom": "^21",
    "playwright": "^1.65",
    "publint": "^0.3.25",
    "react": "^19",
    "react-dom": "^19",
    "storybook": "^10.6",
    "style-dictionary": "^5.8",
    "typescript": "~6.0.3",
    "vite": "^8",
    "vite-plugin-dts": "^5",
    "vitest": "^5",
    "vue": "^3.5",
    "vue-tsc": "^3"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5",
    "@fontsource-variable/source-serif-4": "^5",
    "reka-ui": "^2.11"
  }
}
